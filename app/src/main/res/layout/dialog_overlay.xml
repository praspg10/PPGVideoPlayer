<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6000000"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@android:color/white"
        android:padding="65dp"
        app:layout_constraintWidth_percent="0.85"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtMessage1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Screen Time 30 mins reached"
            android:textColor="@android:color/black"
            android:textSize="44sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/txtMessage2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Please play with other toys"
            android:textColor="@android:color/black"
            android:textSize="54sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:layout_marginBottom="40dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOverlayOk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OK"
            android:textSize="32sp"
            android:paddingStart="64dp"
            android:paddingEnd="64dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            app:cornerRadius="16dp"
            android:backgroundTint="@color/ytk_primary_red" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>